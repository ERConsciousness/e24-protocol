# Copia este archivo como `.env` (ignorado por git) y complétalo.
# SOLO TESTNET. Nunca pongas aquí una clave que tenga o haya tenido fondos reales.

# Clave privada (0x…) de la cuenta que despliega y hace de relayer en L0.
# Créala nueva para esto y fondéala solo con ETH de faucet de Base Sepolia.
E24_CLAVE_DESPLIEGUE=

# RPC de Base Sepolia (opcional; por defecto, el público https://sepolia.base.org).
E24_RPC_BASE_SEPOLIA=

# Clave de API de Etherscan (v2, sirve para Basescan), para verificar el código fuente.
E24_ETHERSCAN_API_KEY=

# Semilla de las personas ficticias de la demo (cualquier texto largo y aleatorio).
# Sus claves se derivan de aquí; las personas son ficticias, pero no la publiques
# si no quieres que otros puedan operar sus DIDs de prueba.
E24_SEMILLA_DEMO=

# Para desplegar en una red pública hay que escribir aquí su nombre (baseSepolia).
# Déjalo vacío salvo en el momento del despliegue.
E24_CONFIRMAR_DESPLIEGUE=
